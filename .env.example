ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
SQLITE_PATH=data/portal11run.sqlite
UPLOAD_DIR=data/uploads
VIRTUAL_CIRCUIT_PRIVATE_UPLOAD_DIR=data/virtual-circuit-private
SUPPORT_PRIVATE_UPLOAD_DIR=data/support-private
# URL pública usada nos retornos do checkout Stripe.
NEXT_PUBLIC_SITE_URL=https://11run.com.br

# Segredo opcional para agendadores externos. O workflow oficial usa OIDC temporário do GitHub.
CRON_SECRET=substitua-por-um-segredo-aleatorio-longo

# Gere com um segredo aleatório de pelo menos 32 caracteres. Não reutilize a chave da Stripe.
VIRTUAL_CIRCUIT_DATA_KEY=substitua-por-um-segredo-aleatorio-longo

# Documentos privados dos Desafios 11RUN. Gere uma chave aleatória exclusiva com ao menos 32 caracteres.
CHALLENGE_DATA_KEY=substitua-por-um-segredo-aleatorio-longo
CHALLENGE_PRIVATE_UPLOAD_DIR=data/private/member-challenges
# Opcional: sem este valor, o módulo reutiliza o modelo de IA configurado no painel do sistema.
OPENAI_DOCUMENT_MODEL=

# Fase 2 (opcional). Sem estas variáveis, toda inscrição segue para revisão humana.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://seu-dominio/api/circuito-virtual/strava/callback
VIRTUAL_CIRCUIT_AI_PROVIDER=

# Use uma chave restrita da Stripe com acesso apenas a Checkout Sessions.
STRIPE_SECRET_KEY=rk_live_substitua_por_uma_chave_restrita

# Gerado ao cadastrar https://seu-dominio/api/stripe/webhook no Stripe Workbench.
STRIPE_WEBHOOK_SECRET=whsec_substitua_pelo_segredo_do_webhook

# E-mails transacionais da área Apoie. Sem estas variáveis, os envios ficam registrados como pendentes.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=11RUN <contato@11run.com.br>
ADMIN_NOTIFICATION_EMAIL=

# Identificação pública do controlador e canal de privacidade/LGPD.
# Preencha antes da publicação definitiva da política. Não use dados fictícios.
PRIVACY_CONTROLLER_LEGAL_NAME=
PRIVACY_CONTROLLER_TRADE_NAME=11RUN
PRIVACY_CONTROLLER_CNPJ=
PRIVACY_CONTROLLER_ADDRESS=
PRIVACY_CONTACT_EMAIL=
PRIVACY_CONTACT_WHATSAPP=
PRIVACY_DPO_NAME=
